# --- Persistence ---
DATABASE_URL=postgresql://user:pass@localhost:5432/marea

# --- Solana $RIV access gate (read-only) ---
SOLANA_RPC_URL=                 # Helius RPC URL works here
SOLANA_NETWORK=devnet
MAREA_TOKEN_MINT=               # devnet test mint first
MAREA_GATE_MIN=1                # minimum balance to enter

# --- Server ---
PORT=2567

# Where player data is persisted (JSON). Survives restarts/deploys. Defaults to
# ./data/marea.json relative to the server's working directory.
MAREA_DATA_FILE=

# When true, the server runs without Postgres (in-memory) and skips the $RIV
# balance check. A connected Solana wallet is ALWAYS required either way —
# dev-open only lets a connected wallet in without holding the token.
MAREA_DEV_OPEN=true
