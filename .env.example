# --- Persistence ---
DATABASE_URL=postgresql://user:pass@localhost:5432/marea

# --- Solana $RIV access gate (read-only) ---
SOLANA_RPC_URL=                 # Helius RPC URL works here
SOLANA_NETWORK=devnet
MAREA_TOKEN_MINT=               # devnet test mint first
MAREA_GATE_MIN=1                # minimum balance to enter

# --- Server ---
PORT=2567

# When true, the server runs without Postgres (in-memory) and without the
# Solana gate (everyone is allowed in). Useful for Phase 0/1 local dev.
MAREA_DEV_OPEN=true
