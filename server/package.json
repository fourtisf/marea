{
  "name": "@marea/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node -c blue,green \"tsc -w -p tsconfig.json\" \"node --watch dist/index.js\"",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@marea/shared": "*",
    "@colyseus/core": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "colyseus": "^0.16.0",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
